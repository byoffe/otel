        "reduceOptions": { "calcs": ["lastNotNull"] },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(pipeline_duration_milliseconds_bucket{service_name=\"gateway-svc\",le=\"5000\"}[$__rate_interval])) / sum(rate(pipeline_duration_milliseconds_count{service_name=\"gateway-svc\"}[$__rate_interval]))",
          "instant": true,
          "legendFormat": "% under 5s",
          "refId": "A"
        }
      ],
      "title": "SLO: Jobs Completing Under 5s",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "continuous-GrYlRd" },
          "custom": { "fillOpacity": 80, "lineWidth": 1 }
        },
        "overrides": []
      },
      "gridPos": { "h": 9, "w": 14, "x": 0, "y": 9 },
      "id": 3,
      "options": {
        "calculate": false,
        "cellGap": 1,
        "color": { "mode": "scheme", "scheme": "Spectral", "steps": 64 },
        "exemplars": { "color": "rgba(255,0,255,0.7)" },
