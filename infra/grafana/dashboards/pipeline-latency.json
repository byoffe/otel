      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.50, sum by (le) (rate(pipeline_duration_milliseconds_bucket{service_name=\"gateway-svc\"}[$__rate_interval])))",
          "legendFormat": "p50 end-to-end",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(pipeline_duration_milliseconds_bucket{service_name=\"gateway-svc\"}[$__rate_interval])))",
          "legendFormat": "p95 end-to-end",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(pipeline_duration_milliseconds_bucket{service_name=\"gateway-svc\"}[$__rate_interval])))",
          "legendFormat": "p99 end-to-end",
          "refId": "C"
        }
      ],
      "title": "End-to-End Pipeline Latency (gateway root span)",
