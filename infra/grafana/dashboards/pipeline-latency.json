        "legend": { "show": true },
        "rowsFrame": { "layout": "auto" },
        "tooltip": { "mode": "single", "yHistogram": true },
        "yAxis": { "axisLabel": "ms", "axisPlacement": "left", "reverse": false, "unit": "ms" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(pipeline_duration_milliseconds_bucket{service_name=\"gateway-svc\"}[$__rate_interval])) by (le)",
          "format": "heatmap",
          "legendFormat": "{{le}}",
          "refId": "A"
        }
      ],
      "title": "End-to-End Duration Heatmap",
      "type": "heatmap"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "continuous-GrYlRd" },
          "unit": "ms",
          "min": 0
        },
        "overrides": []
      },
      "gridPos": { "h": 9, "w": 10, "x": 14, "y": 9 },
      "id": 4,
      "options": {
        "displayMode": "gradient",
        "maxVizHeight": 300,
